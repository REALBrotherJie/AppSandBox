<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView android:id="@+id/guest_counter" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:id="@+id/guest_increment" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <Button android:id="@+id/guest_reset" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <Button android:id="@+id/guest_toggle" android:layout_width="wrap_content" android:layout_height="wrap_content" />
</LinearLayout>
